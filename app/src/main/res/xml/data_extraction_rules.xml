<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The encrypted API key and downloaded voice models are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
        <exclude domain="sharedpref" path="assistant_secrets_gemini.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
        <exclude domain="sharedpref" path="assistant_secrets_gemini.xml" />
    </device-transfer>
</data-extraction-rules>
