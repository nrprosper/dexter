<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Only preferences are backed up, never files (voice models); the encrypted API key is excluded. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="device.xml" />
    <exclude domain="sharedpref" path="assistant_secrets.xml" />
</full-backup-content>
